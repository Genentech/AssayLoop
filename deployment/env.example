# The Hugging Face model repository is private until the public release.
# Use a read-only token; never commit its value.
HF_TOKEN=

# Required only for user-entered screen descriptions that are not among the
# public screens whose text embeddings ship with AssayLoop.
OPENAI_API_KEY=

# Comma-separated browser origins allowed to call the API.
ASSAYLOOP_ALLOWED_ORIGINS=https://genentech.github.io

# Optional runtime settings.
ASSAYFORMER_DEVICE=auto
# ASSAYFORMER_PROBABILITY_SAMPLES=4000
# ASSAYFORMER_CHECKPOINT=/absolute/path/to/the/released/s19/checkpoint
# ASSAYFORMER_CACHE_DIR=/persistent/model/cache
